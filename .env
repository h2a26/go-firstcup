# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales
POSTGRES_HOST=database

# Auth Service
AUTH_DB_USER=${POSTGRES_USER}
AUTH_DB_PASSWORD=${POSTGRES_PASSWORD}
AUTH_DB_HOST=${POSTGRES_HOST}
AUTH_DB_NAME=${POSTGRES_DB}
AUTH_DB_DISABLE_TLS=true
AUTH_WEB_TRACE_HOST=tempo:4317

# Sales Service
SALES_DB_USER=${POSTGRES_USER}
SALES_DB_PASSWORD=${POSTGRES_PASSWORD}
SALES_DB_HOST=${POSTGRES_HOST}
SALES_DB_NAME=${POSTGRES_DB}
SALES_DB_DISABLE_TLS=true
SALES_AUTH_HOST=http://auth:6000

# Common Settings
GOMAXPROCS=2
OTEL_SERVICE_NAME=auth
OTEL_TRACES_SAMPLER=always_on

# logging
ELK_HOST=logstash
ELK_PORT=5000
ELK_PROTOCOL=tcp
LOG_LEVEL=debug
LOG_OUTPUT=console,elk

# Metrics
METRICS_COLLECT_FROM=http://sales:3010/debug/vars,http://auth:6010/debug/vars

# Grafana
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_FEATURE_TOGGLES_ENABLE=traceToLogs
GF_TRACING_JAEGER_DISABLED=false
GF_TRACING_JAEGER_ADDRESS=tempo:6831
