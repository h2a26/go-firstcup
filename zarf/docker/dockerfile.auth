# --- BUILD STAGE ---
FROM golang:1.25-alpine AS build_auth
ENV CGO_ENABLED=0

ARG BUILD_REF
WORKDIR /app

# 1. Dependency Caching: Copy only go.mod and go.sum first.
COPY go.mod go.sum ./
RUN go mod download

# 2. Source Code Copy: Copy the rest of the source code.
COPY . .

# Build the binary from its specific directory.
WORKDIR /app/api/services/auth

# 3. Binary Optimization: Use -s and -w ldflags to strip debug symbols and DWARF tables.
RUN go build -ldflags "-s -w -X main.build=${BUILD_REF}" -o /bin/auth

# --- RUNTIME STAGE ---
# Use the minimal Alpine image for the final production container.
FROM alpine:3.22
ARG BUILD_DATE
ARG BUILD_REF

# 4. Security: Create a non-root user and group ('auth') with ID 1000.
RUN addgroup -g 1000 -S auth && \
    adduser -u 1000 -h /app -G auth -S auth

WORKDIR /app

# 5. Copy Assets: Copy necessary external assets (keys/config) from the build stage.
COPY --from=build_auth --chown=auth:auth /app/zarf/keys/. /app/zarf/keys/.

# 6. Copy Binary: Copy ONLY the compiled, stripped binary from the build stage.
COPY --from=build_auth --chown=auth:auth /bin/auth /app/auth

# Ensure the binary is executable
RUN chmod +x /app/auth

# 7. Switch User: Run all subsequent commands and the final application as the non-root user.
USER auth

# 8. Entrypoint: Use the exec form (preferred) to execute the binary.
CMD ["/app/auth"]

# OCI Labels (Best practice for image metadata)
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="auth" \
      org.opencontainers.image.authors="hein<heindaemon@gmail.com>" \
      org.opencontainers.image.source="https://github.com/h2a26/go-firstcup/tree/master/a/services/auth" \
      org.opencontainers.image.revision="${BUILD_REF}" \
      org.opencontainers.image.vendor="summer scent"