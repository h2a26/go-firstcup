# -------- Stage 1: Builder --------
FROM golang:1.25.3-alpine AS build
# 🏗️ Builder stage: full Go environment + tools for building

# 🛠️ Install tools: UPX, objcopy, gcc, musl-dev
RUN apk add --no-cache upx binutils gcc musl-dev

# 📂 Set working directory inside builder
WORKDIR /app

# 📦 Copy Go modules and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# 📝 Copy source code into builder
COPY . .

# 1️⃣ Build fully static Go binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath -o /app/metrics_app ./api/services/metrics
# ⚡ Output: /app/metrics_app (raw Go binary)

# 2️⃣ Strip debug symbols for smaller binary
RUN objcopy --strip-all /app/metrics_app /app/stripped_metrics_app
# 🗜️ Output: /app/stripped_metrics_app (smaller, no debug info)

# 3️⃣ Compress binary with UPX
RUN upx --best --lzma -o /app/metrics_app_compressed /app/stripped_metrics_app
# 📉 Output: /app/metrics_app_compressed (final, tiny binary for production)

# -------- Stage 2: Final Stage (scratch) --------
FROM scratch
# 🧹 Final stage: empty minimal image


# 📂 Set working directory inside runtime
WORKDIR /app

# 📂 Copy the compressed binary into final image
COPY --from=build /app/metrics_app_compressed /app/metrics

# ▶️ Set entrypoint to run the binary
ENTRYPOINT ["/app/metrics"]
